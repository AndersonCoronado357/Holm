HOLM_API_PORT=5192
HOLM_JWT_SECRET=cambia_esto_por_un_secreto_largo_aleatorio

# MongoDB — local: Mongo del PC. Producción (acmsy): base gestionada db-holm.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=holm
MONGO_USER=admin
MONGO_PASSWORD=tu_password_de_mongo
MONGO_AUTH_SOURCE=admin

# Google OAuth — cliente compartido "acmsy web". El secret vive en
# ~/acmsy/secrets.env y lo inyecta useAcmsyAuth en producción.
GOOGLE_CLIENT_ID=487360576094-k5usrjm1b699kgv1nu3lat4ev0kpe8v8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Origen público (OAuth + redirecciones). Local: la URL de Vite.
# Producción: https://holm.acmsy.com (o fija ACMSY_SUBDOMAIN=holm).
ORIGIN=http://localhost:5191

# --- Solo en producción (contenedor acmsy) ---
# NODE_ENV=production
# HOLM_API_HOST=0.0.0.0
# ACMSY_SUBDOMAIN=holm
# SESSION_SECRET / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET -> inyectados por useAcmsyAuth

# --- Avisos por Web Push ---
# Sin estas claves el servidor no manda nada y la app cae a los temporizadores
# del navegador (que solo funcionan con Holm abierto). Se generan una vez con:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# El par tiene que ser ESTABLE: si cambia, las suscripciones guardadas dejan de
# valer y hay que volver a activar los avisos en cada dispositivo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
# Secreto para disparar el programador a mano: POST /api/push/run
CRON_SECRET=
# Desfase del reloj local del usuario respecto a UTC, en minutos (Colombia: -300).
# HOLM_TZ_OFFSET_MINUTES=-300
